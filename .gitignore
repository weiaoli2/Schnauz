/target
/.build-cache/
**/*.rs.bk
.DS_Store

# Distributable installer binaries — published as GitHub Release assets,
# never committed to Git (they bloat history and every clone).
*.dmg

# The built app bundle is a generated artifact (make_app.sh rebuilds it);
# it ships as a Release asset, never committed.
/Schnauz.app/
/.build-notes.log
/assets/*.iconset/

# Local AI-tooling / editor state — never ship with the app.
.agents/
.claude/
skills-lock.json
release-notes-*.md

# Architecture-specific release staging
/dist/

# Personal account settings and credentials never belong in source control
.env
.env.*
*.p12
*.pfx
*.key
/id_rsa
/id_ed25519
/todoist.json
/nextcloud.json
/projects.json
/prefs.txt
